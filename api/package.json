{
  "name": "api",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start:api": "vercel dev --listen 3001",
    "build:api": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@supabase/supabase-js": "2.105.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "prisma": "7.8.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vercel": "^53.4.0",
    "vitest": "4.1.6"
  }
}
