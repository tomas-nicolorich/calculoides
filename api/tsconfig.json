{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "*.ts", "scripts/**/*.ts", "tests/**/*.ts", "src/types/**/*.d.ts", "members/**/*.ts", "groups/**/*.ts"]
}
