{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/*": ["_src/*"]
    }
  },
  "include": ["_src/**/*.ts", "*.ts", "scripts/**/*.ts", "_tests/**/*.ts", "_src/types/**/*.d.ts", "members/**/*.ts", "groups/**/*.ts"]
}
