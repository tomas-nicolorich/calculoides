{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "**/__mocks__/**",
    "prisma.config.ts",
    "frontend/src/test/setup.ts",
    "**/prisma/client/**",
    "frontend/dist/**",
    "api/dist/**",
    "api/_src/handlers/users.ts",
    "frontend/scripts/screenshot.mjs",
    "next-env.d.ts"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "ignoreDependencies": [
    "postcss-load-config"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "circular-dependencies": "error"
  }
}
