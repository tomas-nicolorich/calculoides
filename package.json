{
  "name": "calculoides",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "type": "module",
  "workspaces": [
    "frontend",
    "api",
    "shared"
  ],
  "scripts": {
    "dev": "turbo run dev start:api",
    "dev:local": "turbo run dev start:api:local",
    "dev:next": "next dev",
    "build": "turbo run build",
    "build:next": "next build",
    "start:next": "next start",
    "test": "vitest run --config vitest.config.ts && turbo run test",
    "test:next": "vitest run --config vitest.config.ts",
    "test:local": "cross-env CALC_ENVIRONMENT=test-local turbo run test",
    "lint": "eslint app lib middleware.ts next.config.ts --max-warnings 0 && turbo run lint",
    "lint:next": "eslint app lib middleware.ts next.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.next.json && turbo run typecheck",
    "typecheck:next": "tsc --noEmit -p tsconfig.next.json",
    "prepare": "husky",
    "postinstall": "npm run prisma:generate -w api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.0.0",
    "supabase": "^2.107.0",
    "turbo": "^2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.6"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4.3.3"
  }
}
