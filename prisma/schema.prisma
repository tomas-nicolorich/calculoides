generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "calculoides"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model auth_users {
  instance_id                 String?            @db.Uuid
  id                          String             @id @db.Uuid
  aud                         String?            @db.VarChar(255)
  role                        String?            @db.VarChar(255)
  email                       String?            @unique(map: "users_email_partial_key", where: raw("(is_sso_user = false)")) @db.VarChar(255)
  encrypted_password          String?            @db.VarChar(255)
  email_confirmed_at          DateTime?          @db.Timestamptz(6)
  invited_at                  DateTime?          @db.Timestamptz(6)
  confirmation_token          String?            @unique(map: "confirmation_token_idx", where: raw("((confirmation_token)::text !~ '^[0-9 ]*$'::text)")) @db.VarChar(255)
  confirmation_sent_at        DateTime?          @db.Timestamptz(6)
  recovery_token              String?            @unique(map: "recovery_token_idx", where: raw("((recovery_token)::text !~ '^[0-9 ]*$'::text)")) @db.VarChar(255)
  recovery_sent_at            DateTime?          @db.Timestamptz(6)
  email_change_token_new      String?            @unique(map: "email_change_token_new_idx", where: raw("((email_change_token_new)::text !~ '^[0-9 ]*$'::text)")) @db.VarChar(255)
  email_change                String?            @db.VarChar(255)
  email_change_sent_at        DateTime?          @db.Timestamptz(6)
  last_sign_in_at             DateTime?          @db.Timestamptz(6)
  raw_app_meta_data           Json?
  raw_user_meta_data          Json?
  is_super_admin              Boolean?
  created_at                  DateTime?          @db.Timestamptz(6)
  updated_at                  DateTime?          @db.Timestamptz(6)
  phone                       String?            @unique
  phone_confirmed_at          DateTime?          @db.Timestamptz(6)
  phone_change                String?            @default("")
  phone_change_token          String?            @default("") @db.VarChar(255)
  phone_change_sent_at        DateTime?          @db.Timestamptz(6)
  confirmed_at                DateTime?          @default(dbgenerated("LEAST(email_confirmed_at, phone_confirmed_at)")) @db.Timestamptz(6)
  email_change_token_current  String?            @unique(map: "email_change_token_current_idx", where: raw("((email_change_token_current)::text !~ '^[0-9 ]*$'::text)")) @default("") @db.VarChar(255)
  email_change_confirm_status Int?               @default(0) @db.SmallInt
  banned_until                DateTime?          @db.Timestamptz(6)
  reauthentication_token      String?            @unique(map: "reauthentication_token_idx", where: raw("((reauthentication_token)::text !~ '^[0-9 ]*$'::text)")) @default("") @db.VarChar(255)
  reauthentication_sent_at    DateTime?          @db.Timestamptz(6)
  is_sso_user                 Boolean            @default(false)
  deleted_at                  DateTime?          @db.Timestamptz(6)
  is_anonymous                Boolean            @default(false)
  users                       calculoides_users?

  @@index([instance_id])
  @@index([is_anonymous])
  @@map("users")
  @@schema("auth")
}

model categories {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId          String             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  icon             String?
  monthlyBudget    Decimal            @db.Decimal(12, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  groups           groups             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category_members category_members[]
  expenses         expenses[]
  transfers        transfers[]

  @@schema("calculoides")
}

model category_members {
  id                                                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId                                         String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId                                           String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categories                                         categories    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group_members                                      group_members @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transfers_transfers_fromMemberIdTocategory_members transfers[]   @relation("transfers_fromMemberIdTocategory_members")
  transfers_transfers_toMemberIdTocategory_members   transfers[]   @relation("transfers_toMemberIdTocategory_members")

  @@unique([categoryId, memberId])
  @@schema("calculoides")
}

model expenses {
  id            String        @id @db.Uuid
  categoryId    String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payerId       String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @default(now())
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  categories    categories    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  group_members group_members @relation(fields: [payerId], references: [id], onDelete: SetNull)

  @@schema("calculoides")
}

model group_members {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String                       @db.Uuid
  groupId                    String                       @db.Uuid
  income                     Decimal                      @default(0) @db.Decimal(12, 2)
  joinedAt                   DateTime                     @default(now())
  category_members           category_members[]
  expenses                   expenses[]
  groups                     groups                       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  users                      calculoides_users            @relation(fields: [userId], references: [id], onDelete: SetNull)
  savings_goal_contributions savings_goal_contributions[]

  @@unique([userId, groupId])
  @@schema("calculoides")
}

model groups {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  ownerId                    String                       @db.Uuid
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  categories                 categories[]
  group_members              group_members[]
  users                      calculoides_users            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  invitations                invitations[]
  savings_goal_contributions savings_goal_contributions[]
  savings_goals              savings_goals[]

  @@schema("calculoides")
}

model invitations {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  status    invitation_status @default(pending)
  inviterId String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime
  groups    groups            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  users     calculoides_users @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@schema("calculoides")
}

model savings_goal_contributions {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId        String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId      String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customAmount  Decimal       @db.Decimal(12, 2)
  savings_goals savings_goals @relation(fields: [goalId], references: [id], onDelete: Cascade)
  group_members group_members @relation(fields: [memberId], references: [id], onDelete: Cascade)
  groups        groups?       @relation(fields: [groupsId], references: [id])
  groupsId      String?       @db.Uuid

  @@unique([goalId, memberId])
  @@schema("calculoides")
}

model savings_goals {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId                    String                       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  targetAmount               Decimal                      @db.Decimal(12, 2)
  targetDate                 DateTime
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  groups                     groups                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  savings_goal_contributions savings_goal_contributions[]

  @@schema("calculoides")
}

model transfers {
  id                                                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId                                                String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromMemberId                                              String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toMemberId                                                String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount                                                    Decimal          @db.Decimal(12, 2)
  date                                                      DateTime         @default(now())
  categories                                                categories       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  category_members_transfers_fromMemberIdTocategory_members category_members @relation("transfers_fromMemberIdTocategory_members", fields: [fromMemberId], references: [id], onDelete: Cascade)
  category_members_transfers_toMemberIdTocategory_members   category_members @relation("transfers_toMemberIdTocategory_members", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@schema("calculoides")
}

model calculoides_users {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String          @unique
  name          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  group_members group_members[]
  groups        groups[]
  invitations   invitations[]
  users         auth_users      @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("users")
  @@schema("calculoides")
}

enum invitation_status {
  pending
  accepted
  declined

  @@schema("calculoides")
}
